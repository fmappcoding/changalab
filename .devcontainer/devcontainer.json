{
  "name": "ChangaLab",
  "image": "mcr.microsoft.com/devcontainers/php:8.3",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "ChangaLab web",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },
  "remoteUser": "codespace"
}
