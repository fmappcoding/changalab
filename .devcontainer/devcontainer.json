{
  "name": "ChangaLab Runtime (PHP/Composer/MySQL)",
  "image": "mcr.microsoft.com/devcontainers/ubuntu:22.04",
  "features": {},
  "onCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug"
      ]
    }
  },
  "forwardPorts": [80, 3306, 8000],
  "remoteUser": "root"
}
