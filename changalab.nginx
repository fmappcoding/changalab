server {
    listen 8080;
    listen [::]:8080;
    server_name $host;
    absolute_redirect off;

    root /workspaces/changalab/Files;
    index index.php index.html;

    # Laravel-style rewrites: assets served directly, everything else -> index.php
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # PHP handling via FPM unix socket
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Deny access to core internals and hidden files
    location ~ /\.(?!well-known).* {
        deny all;
    }

    location ~ /(core|install|storage|vendor)/.*\.(php|env|json|lock)$ {
        deny all;
    }

    access_log /var/log/nginx/changalab.access.log;
    error_log  /var/log/nginx/changalab.error.log;
}
